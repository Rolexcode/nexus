rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hackathon prototype only: anonymous Firebase-authenticated clients may
    // read/write the two shared demo-state documents used by Nexus.
    match /nexus-demo/{documentId} {
      allow read, write: if request.auth != null
        && (documentId == 'nexus-incidents:v2' || documentId == 'nexus-attestations:v2');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
