rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/nexus-admins/$(request.auth.uid));
    }

    match /nexus-demo/{documentId} {
      allow read: if documentId == 'nexus-incidents:v2'
        || documentId == 'nexus-attestations:v2';
      allow write: if signedIn()
        && (documentId == 'nexus-incidents:v2'
          || documentId == 'nexus-attestations:v2');
    }

    match /nexus-users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /nexus-admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /nexus-evidence/{incidentId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /nexus-case-reporters/{incidentId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Student/provider recommendations stay private until an administrator approves them.
    match /nexus-service-submissions/{listingId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Approved service listings are public and carry the verified badge.
    match /nexus-services/{listingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reviews are public. One document id is derived from listing + user, so one account has one review per listing.
    match /nexus-reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Events and announcements also pass through moderation before publication.
    match /nexus-board-submissions/{postId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /nexus-board/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public feedback: anyone may send a bounded suggestion without creating an account.
    // Only administrators can read or moderate these submissions.
    match /nexus-suggestions/{suggestionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'json', 'category', 'message', 'contact', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'json', 'category', 'message', 'contact', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 2600
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 48
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 2000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 120
        && request.resource.data.source == 'nexus-feedback'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp;

      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
